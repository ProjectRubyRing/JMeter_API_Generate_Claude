    <hashTree>
      <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="[必須] 共通変数 (User Defined Variables)" enabled="true">
        <stringProp name="TestPlan.comments">[必須] 接続先と共通変数。値は ${__P(名前,既定値)} 形式のため、実行時に -J名前=値 で変更できます。
各 API（HTTP リクエスト）が ${PROTOCOL} ${HOST} ${PORT} を参照しているため削除しないでください。</stringProp>
        <collectionProp name="Arguments.arguments">
          <elementProp name="PROTOCOL" elementType="Argument">
            <stringProp name="Argument.name">PROTOCOL</stringProp>
            <stringProp name="Argument.value">${__P(PROTOCOL,https)}</stringProp>
            <stringProp name="Argument.desc">プロトコル（http / https）。-JPROTOCOL=値 で変更</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="HOST" elementType="Argument">
            <stringProp name="Argument.name">HOST</stringProp>
            <stringProp name="Argument.value">${__P(HOST,postman-echo.com)}</stringProp>
            <stringProp name="Argument.desc">ホスト名。-JHOST=値 で変更</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="PORT" elementType="Argument">
            <stringProp name="Argument.name">PORT</stringProp>
            <stringProp name="Argument.value">${__P(PORT,)}</stringProp>
            <stringProp name="Argument.desc">ポート番号（空欄 = http は 80 / https は 443）。-JPORT=値 で変更</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="ENV" elementType="Argument">
            <stringProp name="Argument.name">ENV</stringProp>
            <stringProp name="Argument.value">${__P(ENV,staging)}</stringProp>
            <stringProp name="Argument.desc">共通変数。-JENV=値 で変更</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="CLIENT_ID" elementType="Argument">
            <stringProp name="Argument.name">CLIENT_ID</stringProp>
            <stringProp name="Argument.value">${__P(CLIENT_ID,jmeter-client)}</stringProp>
            <stringProp name="Argument.desc">共通変数。-JCLIENT_ID=値 で変更</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </Arguments>
      <hashTree/>
      <ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement" testname="[任意] HTTPリクエスト初期値 (HTTP Request Defaults)" enabled="true">
