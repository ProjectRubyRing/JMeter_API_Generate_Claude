      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="[任意] テスト開始処理 (JSR223 Sampler)" enabled="true">
          <stringProp name="TestPlan.comments">[任意] 実行条件（パラメータ欄）を jmeter.log に出力し、結果ログ用の集計値をリセットします。</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters">THREADS=${__P(THREADS,1)} RAMP_UP=${__P(RAMP_UP,1)} LOOPS=${__P(LOOPS,1)} HOST=${HOST} RESULT_DIR=${__P(RESULT_DIR,~/result)}</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">// ============================================================
// [任意] テスト開始処理（setUp Thread Group / JSR223 Sampler）
//  テスト開始時に1回だけ実行されます。
//  ・実行条件（パラメータ欄）を jmeter.log に出力します。
//  ・前回の実行（GUI で連続実行した場合）の集計値・結果ログをリセットします。
//  削除しても他の要素の動作には影響しません。
// ============================================================
SampleResult.setIgnore()   // この処理はレポート・JTL に含めない

def oldWriter = props.remove(&apos;API_RESULT_LOG_WRITER&apos;)
if (oldWriter != null) {
    try {
        oldWriter.close()
    } catch (Exception ignored) {
    }
}
[&apos;API_RESULT_TOTAL&apos;, &apos;API_RESULT_OK&apos;, &apos;API_RESULT_NG&apos;].each { props.remove(it) }
props.put(&apos;API_TEST_START_MS&apos;, String.valueOf(System.currentTimeMillis()))
log.info(&apos;==== テスト開始: &apos; + (Parameters ?: &apos;&apos;))
</stringProp>
        </JSR223Sampler>
        <hashTree/>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="[任意] Excelデータ読込 (JSR223 Sampler)" enabled="true">
          <stringProp name="TestPlan.comments">[任意] Excel（.xlsx）を読み込みます（Apache POI 不要）。1 行目 = 変数名、2 行目以降 = データ。
パラメータ: ファイルパス|シート名（-JEXCEL_FILE / -JEXCEL_SHEET で変更可。相対パスは JMX のフォルダ基準）。
削除する場合は、メイン処理の「Excelデータ行取得」も削除してください。</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters">${__P(EXCEL_FILE,data/testdata.xlsx)}|${__P(EXCEL_SHEET,)}</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">// ============================================================
// [任意] Excelデータ読込（setUp Thread Group / JSR223 Sampler）
//  テスト開始前に1回だけ実行され、Excel(.xlsx)の内容をメモリに読み込みます。
//  ・Apache POI などの追加ライブラリは不要です（xlsx を ZIP + XML として直接解析）。
//  ・1行目 = 列名（そのまま変数名になります）、2行目以降 = データ。空行は無視します。
//  ・読み込んだデータは props &apos;EXCEL_DATA&apos; に保存され、メイン処理の
//    「Excelデータ行取得」が反復ごとに1行ずつ変数に設定します。
//  ・パラメータ欄: ファイルパス|シート名（シート名が空の場合は先頭シート）
//    相対パスは JMX ファイルのフォルダが基準です。-JEXCEL_FILE / -JEXCEL_SHEET で変更できます。
//  ・数値・日付はセルに保存されている値（表示書式の適用前）になります。
//    表示どおりの値を使いたい列は、Excel 側でセルの書式を「文字列」にしてください。
// ============================================================
import java.util.concurrent.atomic.AtomicLong
import java.util.zip.ZipFile
import javax.xml.parsers.DocumentBuilderFactory
import org.apache.jmeter.services.FileServer

SampleResult.setIgnore()   // この処理はレポート・JTL に含めない

String[] params = (Parameters ?: &apos;&apos;).split(&apos;\\|&apos;, -1)
String path = params.length &gt; 0 ? params[0].trim() : &apos;&apos;
String sheetName = params.length &gt; 1 ? params[1].trim() : &apos;&apos;
props.remove(&apos;EXCEL_DATA&apos;)
props.put(&apos;EXCEL_ROW_COUNTER&apos;, new AtomicLong(0))
if (path.isEmpty()) {
    log.warn(&apos;[Excel] ファイルパスが指定されていません&apos;)
    return
}
File file = new File(path)
if (!file.isAbsolute()) {
    file = new File(FileServer.getFileServer().getBaseDir(), path)
}
if (!file.isFile()) {
    log.warn(&apos;[Excel] ファイルが見つかりません: &apos; + file.getAbsolutePath())
    return
}

def factory = DocumentBuilderFactory.newInstance()
factory.setNamespaceAware(true)
factory.setFeature(&apos;http://apache.org/xml/features/disallow-doctype-decl&apos;, true)
def builder = factory.newDocumentBuilder()

// 子要素をローカル名で取得する
def children = { node, String name -&gt;
    def list = []
    if (node == null) {
        return list
    }
    def nodes = node.getChildNodes()
    for (int i = 0; i &lt; nodes.getLength(); i++) {
        def n = nodes.item(i)
        if (n.getNodeType() == org.w3c.dom.Node.ELEMENT_NODE &amp;&amp; n.getLocalName() == name) {
            list.add(n)
        }
    }
    return list
}
// &lt;t&gt; のテキストを連結する（ふりがな rPh は除外）
def textOf
textOf = { node -&gt;
    StringBuilder sb = new StringBuilder()
    def nodes = node.getChildNodes()
    for (int i = 0; i &lt; nodes.getLength(); i++) {
        def n = nodes.item(i)
        if (n.getNodeType() != org.w3c.dom.Node.ELEMENT_NODE || n.getLocalName() == &apos;rPh&apos;) {
            continue
        }
        sb.append(n.getLocalName() == &apos;t&apos; ? n.getTextContent() : textOf(n))
    }
    return sb.toString()
}
// セル参照 &quot;AB12&quot; → 列番号（0 始まり）
def columnIndex = { String ref -&gt;
    int n = 0
    for (char ch : ref.toCharArray()) {
        if (!Character.isLetter(ch)) {
            break
        }
        n = n * 26 + (Character.toUpperCase(ch) - (&apos;A&apos; as char) + 1)
    }
    return n - 1
}

def zip = new ZipFile(file)
try {
    def parse = { String entryName -&gt;
        def entry = zip.getEntry(entryName)
        if (entry == null) {
            return null
        }
        def input = zip.getInputStream(entry)
        try {
            return builder.parse(input).getDocumentElement()
        } finally {
            input.close()
        }
    }
    // 共有文字列
    List&lt;String&gt; shared = []
    children(parse(&apos;xl/sharedStrings.xml&apos;), &apos;si&apos;).each { shared.add(textOf(it)) }
    // シートの特定（workbook.xml → workbook.xml.rels）
    Map&lt;String, String&gt; rels = [:]
    children(parse(&apos;xl/_rels/workbook.xml.rels&apos;), &apos;Relationship&apos;).each {
        rels.put(it.getAttribute(&apos;Id&apos;), it.getAttribute(&apos;Target&apos;))
    }
    String target = null
    String foundName = null
    def sheetsNode = children(parse(&apos;xl/workbook.xml&apos;), &apos;sheets&apos;)
    for (def sheet : children(sheetsNode ? sheetsNode[0] : null, &apos;sheet&apos;)) {
        if (sheetName.isEmpty() || sheet.getAttribute(&apos;name&apos;) == sheetName) {
            def attrs = sheet.getAttributes()
            for (int i = 0; i &lt; attrs.getLength(); i++) {
                def a = attrs.item(i)
                if (a.getLocalName() == &apos;id&apos; &amp;&amp; a.getNamespaceURI() != null) {
                    target = rels.get(a.getNodeValue())
                }
            }
            foundName = sheet.getAttribute(&apos;name&apos;)
            break
        }
    }
    if (target == null) {
        log.warn(&apos;[Excel] シートが見つかりません: &apos; + (sheetName ?: &apos;(先頭シート)&apos;) + &apos; / &apos; + file.getName())
        return
    }
    def sheetRoot = parse(target.startsWith(&apos;/&apos;) ? target.substring(1) : &apos;xl/&apos; + target)
    def sheetData = children(sheetRoot, &apos;sheetData&apos;)
    // セルの読み取り
    List&lt;List&lt;String&gt;&gt; table = []
    for (def row : children(sheetData ? sheetData[0] : null, &apos;row&apos;)) {
        Map&lt;Integer, String&gt; cells = [:]
        int next = 0
        for (def c : children(row, &apos;c&apos;)) {
            String ref = c.getAttribute(&apos;r&apos;)
            int col = ref ? columnIndex(ref) : next
            next = col + 1
            String type = c.getAttribute(&apos;t&apos;)
            String value = &apos;&apos;
            if (type == &apos;inlineStr&apos;) {
                def inline = children(c, &apos;is&apos;)
                value = inline ? textOf(inline[0]) : &apos;&apos;
            } else {
                def v = children(c, &apos;v&apos;)
                String raw = v ? v[0].getTextContent() : &apos;&apos;
                if (type == &apos;s&apos;) {
                    value = raw ? shared[Integer.parseInt(raw.trim())] : &apos;&apos;
                } else if (type == &apos;b&apos;) {
                    value = raw.trim() == &apos;1&apos; ? &apos;TRUE&apos; : &apos;FALSE&apos;
                } else {
                    value = raw
                }
            }
            cells.put(col, value)
        }
        int size = cells.isEmpty() ? 0 : cells.keySet().max() + 1
        List&lt;String&gt; values = []
        for (int i = 0; i &lt; size; i++) {
            values.add(cells.containsKey(i) ? cells.get(i) : &apos;&apos;)
        }
        if (values.any { it.trim() }) {
            table.add(values)
        }
    }
    if (table.isEmpty()) {
        log.warn(&apos;[Excel] データがありません: &apos; + file.getName() + &apos; / &apos; + foundName)
        return
    }
    List&lt;String&gt; headers = table[0].collect { it.trim() }
    List&lt;Map&lt;String, String&gt;&gt; rows = []
    for (int r = 1; r &lt; table.size(); r++) {
        Map&lt;String, String&gt; m = new LinkedHashMap&lt;&gt;()
        for (int i = 0; i &lt; headers.size(); i++) {
            if (headers[i]) {
                m.put(headers[i], i &lt; table[r].size() ? table[r][i] : &apos;&apos;)
            }
        }
        rows.add(m)
    }
    props.put(&apos;EXCEL_DATA&apos;, Collections.unmodifiableList(rows))
    log.info(&apos;[Excel] 読込完了: &apos; + file.getAbsolutePath() + &apos; / シート=&apos; + foundName
            + &apos; / 列=&apos; + headers.findAll { it } + &apos; / データ=&apos; + rows.size() + &apos;行&apos;)
} catch (Exception e) {
    log.error(&apos;[Excel] 読込エラー: &apos; + file.getAbsolutePath(), e)
} finally {
    zip.close()
}
</stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="[必須] メイン処理 (Thread Group)" enabled="true">
        <stringProp name="TestPlan.comments">[必須] API を実行するスレッドグループ。
スレッド数 = -JTHREADS / ランプアップ秒 = -JRAMP_UP / ループ回数 = -JLOOPS（-1 = 無限）</stringProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">${__P(LOOPS,1)}</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">${__P(THREADS,1)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(RAMP_UP,1)}</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <stringProp name="ThreadGroup.duration"></stringProp>
        <stringProp name="ThreadGroup.delay"></stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
      </ThreadGroup>
      <hashTree>
        <CounterConfig guiclass="CounterConfigGui" testclass="CounterConfig" testname="[任意] 連番 SEQ (Counter)" enabled="true">
          <stringProp name="TestPlan.comments">[任意] 反復（ループ）ごとに連番を ${SEQ} に設定します（全スレッドで一意）。</stringProp>
          <stringProp name="CounterConfig.start">1</stringProp>
          <stringProp name="CounterConfig.end"></stringProp>
          <stringProp name="CounterConfig.incr">1</stringProp>
          <stringProp name="CounterConfig.name">SEQ</stringProp>
          <stringProp name="CounterConfig.format">000000</stringProp>
          <boolProp name="CounterConfig.per_user">false</boolProp>
        </CounterConfig>
        <hashTree/>
        <RandomVariableConfig guiclass="TestBeanGUI" testclass="RandomVariableConfig" testname="[任意] 乱数 RANDOM_NO (Random Variable)" enabled="true">
          <stringProp name="TestPlan.comments">[任意] 反復ごとに 1 ～ 99999 の乱数を ${RANDOM_NO} に設定します。</stringProp>
          <stringProp name="maximumValue">99999</stringProp>
          <stringProp name="minimumValue">1</stringProp>
          <stringProp name="outputFormat"></stringProp>
          <boolProp name="perThread">false</boolProp>
          <stringProp name="randomSeed"></stringProp>
          <stringProp name="variableName">RANDOM_NO</stringProp>
        </RandomVariableConfig>
        <hashTree/>
        <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="[任意] CSVデータ読込 (CSV Data Set Config)" enabled="true">
          <stringProp name="TestPlan.comments">[任意] CSV ファイルを 1 反復につき 1 行読み込み、列を変数に設定します（変数: USER_ID,PASSWORD,KEYWORD）。
ファイルは -JCSV_FILE で変更できます（相対パスは JMX のフォルダ基準）。ファイルが無いとスレッドが停止するため、使わない場合は削除してください。</stringProp>
          <stringProp name="delimiter">,</stringProp>
          <stringProp name="fileEncoding">UTF-8</stringProp>
          <stringProp name="filename">${__P(CSV_FILE,data/testdata.csv)}</stringProp>
          <boolProp name="ignoreFirstLine">true</boolProp>
          <boolProp name="quotedData">true</boolProp>
          <boolProp name="recycle">true</boolProp>
          <stringProp name="shareMode">shareMode.all</stringProp>
          <boolProp name="stopThread">false</boolProp>
          <stringProp name="variableNames">USER_ID,PASSWORD,KEYWORD</stringProp>
        </CSVDataSet>
        <hashTree/>
        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="[任意] Excelデータ行取得 (JSR223 PreProcessor)" enabled="true">
          <stringProp name="TestPlan.comments">[任意] 「Excelデータ読込」で読み込んだデータから、反復ごとに次の 1 行を取り出して変数に設定します。</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">// ============================================================
// [任意] Excelデータ行取得（JSR223 PreProcessor）
//  「Excelデータ読込」（setUp）で読み込んだデータから、反復（ループ）ごとに
//  次の1行を取り出し、1行目の列名を変数名として設定します。
//    例: 列名 ITEM_CODE → 変数 ITEM_CODE、使用中の行番号 → 変数 EXCEL_ROW_NO
//  ・全スレッドで共有し、上から順に払い出します。最終行の次は先頭に戻ります。
//  ・同じ反復内の2つ目以降の API では同じ行の値を使います。
// ============================================================
def rows = props.get(&apos;EXCEL_DATA&apos;)
if (rows == null || rows.isEmpty()) {
    return
}
String iteration = String.valueOf(vars.getIteration())
if (iteration == vars.get(&apos;EXCEL_ROW_ITERATION&apos;)) {
    return
}
vars.put(&apos;EXCEL_ROW_ITERATION&apos;, iteration)
def counter = props.get(&apos;EXCEL_ROW_COUNTER&apos;)
long n = counter != null ? counter.getAndIncrement() : 0L
int index = (int) (n % rows.size())
rows.get(index).each { k, v -&gt; vars.put(k, v) }
vars.put(&apos;EXCEL_ROW_NO&apos;, String.valueOf(index + 1))
</stringProp>
        </JSR223PreProcessor>
        <hashTree/>
        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="[任意] 共通前処理 (JSR223 PreProcessor)" enabled="true">
          <stringProp name="TestPlan.comments">[任意] 全 API の呼び出し直前に毎回実行（Groovy）。${REQUEST_ID} ${TIMESTAMP} ${EPOCH_MS} を設定します。</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">// ============================================================
// [任意] 共通前処理（JSR223 PreProcessor）
//  メイン処理内のすべての API の呼び出し直前に毎回実行されます。
//  API 呼び出し前にパラメータを生成・加工する処理をここに書きます。
//  ※ JSR223 内では JMeter の変数参照（ドル記号＋波括弧）は使わず、
//     vars.get(&apos;変数名&apos;) / vars.put(&apos;変数名&apos;, 値) を使います。
// ============================================================
import java.time.ZonedDateTime
import java.time.format.DateTimeFormatter

// リクエストごとの一意な ID とタイムスタンプ → 変数 REQUEST_ID / TIMESTAMP / EPOCH_MS
vars.put(&apos;REQUEST_ID&apos;, UUID.randomUUID().toString())
vars.put(&apos;TIMESTAMP&apos;, ZonedDateTime.now().format(DateTimeFormatter.ISO_OFFSET_DATE_TIME))
vars.put(&apos;EPOCH_MS&apos;, String.valueOf(System.currentTimeMillis()))

// 加工の例（必要に応じてコメントを外して使用）
// String userId = vars.get(&apos;USER_ID&apos;) ?: &apos;&apos;
// vars.put(&apos;USER_ID_UPPER&apos;, userId.toUpperCase())
// vars.put(&apos;TODAY&apos;, new Date().format(&apos;yyyyMMdd&apos;))
</stringProp>
        </JSR223PreProcessor>
        <hashTree/>
        <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="[任意] 共通後処理 (JSR223 PostProcessor)" enabled="true">
          <stringProp name="TestPlan.comments">[任意] 全 API の呼び出し直後に毎回実行（Groovy）。${LAST_STATUS} ${LAST_ELAPSED_MS} を設定します。</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">// ============================================================
// [任意] 共通後処理（JSR223 PostProcessor）
//  メイン処理内のすべての API の呼び出し直後に毎回実行されます。
//  応答からパラメータを取得し、次の API で使う変数に設定する処理をここに書きます。
//  prev = 直前の API の実行結果（SampleResult）
//  ※ 検証（Assertion）より前に実行されるため、prev.isSuccessful() は HTTP レベルの成否です。
// ============================================================
vars.put(&apos;LAST_STATUS&apos;, prev.getResponseCode())
vars.put(&apos;LAST_ELAPSED_MS&apos;, String.valueOf(prev.getTime()))

// 応答 JSON から値を取り出す例（必要に応じてコメントを外して使用）
// if ((prev.getContentType() ?: &apos;&apos;).contains(&apos;json&apos;)) {
//     def json = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
//     vars.put(&apos;RESULT_CODE&apos;, String.valueOf(json?.resultCode))
// }
// 応答ヘッダから値を取り出す例
// def m = prev.getResponseHeaders() =~ /(?im)^X-Request-Id:\s*(.+)$/
// if (m.find()) {
//     vars.put(&apos;RESPONSE_REQUEST_ID&apos;, m.group(1).trim())
// }
</stringProp>
        </JSR223PostProcessor>
