          <hashTree/>
          <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="[任意] API01 待機 500ms (Constant Timer)" enabled="true">
            <stringProp name="TestPlan.comments">[任意] この API の呼び出し前に 500 ミリ秒待機します。</stringProp>
            <stringProp name="ConstantTimer.delay">500</stringProp>
          </ConstantTimer>
          <hashTree/>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="[任意] API01 前処理 (JSR223 PreProcessor)" enabled="true">
            <stringProp name="TestPlan.comments">[任意] この API の呼び出し直前に実行（Groovy）。</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">// 署名の生成例: USER_ID + TIMESTAMP の SHA-256（16進）を変数 SIGNATURE に設定
String src = (vars.get(&apos;USER_ID&apos;) ?: &apos;&apos;) + (vars.get(&apos;TIMESTAMP&apos;) ?: &apos;&apos;)
def digest = java.security.MessageDigest.getInstance(&apos;SHA-256&apos;).digest(src.getBytes(&apos;UTF-8&apos;))
vars.put(&apos;SIGNATURE&apos;, digest.encodeHex().toString())</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
          <RegexExtractor guiclass="RegexExtractorGui" testclass="RegexExtractor" testname="[任意] API01 正規表現抽出 ECHO_URL (Regular Expression Extractor)" enabled="true">
            <stringProp name="TestPlan.comments">[任意] 応答本文から正規表現で抽出し ${ECHO_URL} に設定します（見つからない場合は NOT_FOUND）。</stringProp>
            <stringProp name="RegexExtractor.useHeaders">false</stringProp>
            <stringProp name="RegexExtractor.refname">ECHO_URL</stringProp>
            <stringProp name="RegexExtractor.regex">&quot;url&quot;\s*:\s*&quot;([^&quot;]+)&quot;</stringProp>
            <stringProp name="RegexExtractor.template">$1$</stringProp>
            <stringProp name="RegexExtractor.default">NOT_FOUND</stringProp>
            <boolProp name="RegexExtractor.default_empty_value">false</boolProp>
            <stringProp name="RegexExtractor.match_number">1</stringProp>
