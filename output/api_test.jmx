      <JSR223Listener guiclass="TestBeanGUI" testclass="JSR223Listener" testname="[任意] 結果ログ出力 (JSR223 Listener)" enabled="true">
        <stringProp name="TestPlan.comments">[任意] 1 リクエスト 1 行の結果ログ（api_result.log）を出力します。パラメータ: 出力フォルダ|本文出力(none/error/all)|最大文字数。
大量実行時はファイル書き込みが負荷になるため、削除・無効化を推奨します。</stringProp>
        <stringProp name="scriptLanguage">groovy</stringProp>
        <stringProp name="parameters">${__P(RESULT_DIR,~/result)}|${__P(LOG_RESPONSE,error)}|${__P(LOG_MAX_CHARS,1000)}</stringProp>
        <stringProp name="filename"></stringProp>
        <stringProp name="cacheKey">true</stringProp>
        <stringProp name="script">// ============================================================
// [任意] 結果ログ出力（JSR223 Listener）
//  すべての API の実行結果を 1リクエスト1行（タブ区切り）で api_result.log に出力します。
//  パラメータ欄: 出力フォルダ|本文出力|最大文字数
//   ・出力フォルダ: -JRESULT_DIR で変更（~/ は JMX のフォルダ。run コマンドは自動設定）
//   ・本文出力  : none = 出力しない / error = 失敗時のみ / all = 全件（-JLOG_RESPONSE）
//   ・最大文字数: リクエスト・レスポンス本文の最大文字数（-JLOG_MAX_CHARS）
//  ※ 大量実行時はファイル書き込みが負荷になるため、無効化または none を推奨します。
// ============================================================
import java.text.SimpleDateFormat
import java.util.concurrent.atomic.AtomicLong
import java.util.function.Function
import org.apache.jmeter.services.FileServer

def res = sampleResult
if (res == null) {
    return
}
String[] p = (Parameters ?: &apos;&apos;).split(&apos;\\|&apos;, -1)
String dirText = (p.length &gt; 0 &amp;&amp; p[0].trim()) ? p[0].trim() : &apos;~/result&apos;
String mode = (p.length &gt; 1 &amp;&amp; p[1].trim()) ? p[1].trim().toLowerCase() : &apos;error&apos;
int maxChars = (p.length &gt; 2 &amp;&amp; p[2].trim().isInteger()) ? p[2].trim().toInteger() : 1000

// 件数の集計（テスト終了処理で出力）
def count = { String key -&gt; props.computeIfAbsent(key, { k -&gt; new AtomicLong(0) } as Function).incrementAndGet() }
count(&apos;API_RESULT_TOTAL&apos;)
count(res.isSuccessful() ? &apos;API_RESULT_OK&apos; : &apos;API_RESULT_NG&apos;)

// 出力ファイル（最初の1件で作成し、全スレッドで共有）
def writer = props.computeIfAbsent(&apos;API_RESULT_LOG_WRITER&apos;, { k -&gt;
    File dir = dirText.startsWith(&apos;~/&apos;) ? new File(FileServer.getFileServer().getBaseDir(), dirText.substring(2)) : new File(dirText)
    dir.mkdirs()
    File file = new File(dir, &apos;api_result.log&apos;)
    boolean isNew = !file.exists() || file.length() == 0
    def w = new PrintWriter(new OutputStreamWriter(new FileOutputStream(file, true), &apos;UTF-8&apos;), true)
    if (isNew) {
        w.println([&apos;日時&apos;, &apos;結果&apos;, &apos;ステータス&apos;, &apos;応答時間ms&apos;, &apos;受信バイト&apos;, &apos;ラベル&apos;, &apos;リクエスト&apos;, &apos;スレッド&apos;, &apos;メッセージ&apos;].join(&apos;\t&apos;))
    }
    log.info(&apos;[結果ログ] 出力先: &apos; + file.getAbsolutePath())
    return w
} as Function)

// 改行・タブを除去し、最大文字数で切り詰める
def oneLine = { String s, int limit -&gt;
    if (s == null) {
        return &apos;&apos;
    }
    String t = s.replace(&apos;\r&apos;, &apos;&apos;).replace(&apos;\n&apos;, &apos;\\n&apos;).replace(&apos;\t&apos;, &apos; &apos;)
    return (limit &gt; 0 &amp;&amp; t.length() &gt; limit) ? t.substring(0, limit) + &apos;...(全&apos; + t.length() + &apos;文字)&apos; : t
}
String request = &apos;&apos;
if (res instanceof org.apache.jmeter.protocol.http.sampler.HTTPSampleResult) {
    request = (res.getHTTPMethod() ?: &apos;&apos;) + &apos; &apos; + (res.getUrlAsString() ?: &apos;&apos;)
}
String message = res.getResponseMessage() ?: &apos;&apos;
def failures = res.getAssertionResults().findAll { it.isFailure() || it.isError() }
if (failures) {
    message += &apos; / &apos; + failures.collect { it.getName() + &apos;: &apos; + it.getFailureMessage() }.join(&apos; / &apos;)
}
String time = new SimpleDateFormat(&apos;yyyy-MM-dd HH:mm:ss.SSS&apos;).format(new Date(res.getStartTime()))
String line = [time, res.isSuccessful() ? &apos;OK&apos; : &apos;NG&apos;, res.getResponseCode(), res.getTime(), res.getBytesAsLong(),
               res.getSampleLabel(), request.trim(), res.getThreadName(), oneLine(message, 1000)].join(&apos;\t&apos;)
synchronized (writer) {
    writer.println(line)
    if (mode == &apos;all&apos; || (mode == &apos;error&apos; &amp;&amp; !res.isSuccessful())) {
        writer.println(&apos;\t[REQUEST] &apos; + oneLine(res.getSamplerData(), maxChars))
        writer.println(&apos;\t[RESPONSE] &apos; + oneLine(res.getResponseDataAsString(), maxChars))
    }
}
if (!res.isSuccessful()) {
    log.warn(&apos;[API NG] &apos; + res.getSampleLabel() + &apos; status=&apos; + res.getResponseCode() + &apos; &apos; + oneLine(message, 500))
}
