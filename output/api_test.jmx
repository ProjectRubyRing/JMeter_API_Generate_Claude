        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="[任意] テスト終了処理 (JSR223 Sampler)" enabled="true">
          <stringProp name="TestPlan.comments">[任意] 合計・成功・失敗件数を jmeter.log と結果ログに出力し、結果ログを閉じます。</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">// ============================================================
// [任意] テスト終了処理（tearDown Thread Group / JSR223 Sampler）
//  すべてのスレッドの終了後に1回だけ実行されます。
//  ・合計 / 成功 / 失敗件数と経過時間を jmeter.log と結果ログに出力します。
//    （件数は「結果ログ出力」が有効な場合のみ集計されます）
//  ・結果ログファイルを閉じ、読み込んだ Excel データを解放します。
// ============================================================
SampleResult.setIgnore()   // この処理はレポート・JTL に含めない

def total = props.get(&apos;API_RESULT_TOTAL&apos;)
String counts = total == null ? &apos;件数=集計なし（結果ログ出力が無効）&apos;
        : &apos;合計=&apos; + total.get() + &apos; 成功=&apos; + (props.get(&apos;API_RESULT_OK&apos;)?.get() ?: 0) + &apos; 失敗=&apos; + (props.get(&apos;API_RESULT_NG&apos;)?.get() ?: 0)
String start = props.get(&apos;API_TEST_START_MS&apos;)
String elapsed = start ? &apos; 経過秒=&apos; + (System.currentTimeMillis() - Long.parseLong(start)).intdiv(1000) : &apos;&apos;
String summary = &apos;==== テスト終了: &apos; + counts + elapsed
log.info(summary)

def writer = props.remove(&apos;API_RESULT_LOG_WRITER&apos;)
if (writer != null) {
    synchronized (writer) {
        writer.println(&apos;# &apos; + summary)
        writer.close()
    }
}
props.remove(&apos;EXCEL_DATA&apos;)
props.remove(&apos;EXCEL_ROW_COUNTER&apos;)
</stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>
