          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="[任意] API01 後処理 (JSR223 PostProcessor)" enabled="true">
            <stringProp name="TestPlan.comments">[任意] この API の呼び出し直後に実行（Groovy）。正規表現・JSON 抽出の後に実行されます。</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">// 応答 JSON の解析例: 値を取り出して次の API で使う変数に設定
try {
    def json = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
    vars.put(&apos;LOGIN_USER&apos;, String.valueOf(json?.json?.userId))
} catch (Exception e) {
    log.warn(&apos;ログイン応答の解析に失敗しました: &apos; + e.getMessage())
}</stringProp>
